# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Anthropic (Claude AI for auto-responses)
ANTHROPIC_API_KEY="sk-ant-..."

# Google OAuth — enables "Continue with Google" sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Channex channel manager ---------------------------------------------
#
# CHANNEX_BASE_URL decides WHICH CHANNEX you are writing to, and getting it
# wrong is silent in both directions. Set it explicitly in every environment.
#
# It DEFAULTS to staging when unset (see lib/channels/channex-core.ts), so an
# environment holding real production credentials but no value here will write
# to staging and look like it is working. The reverse mistake - production's
# URL in a test environment - edits a live listing's prices and availability.
#
#   development / staging   https://staging.channex.io/api/v1
#   production              https://staging.channex.io/api/v1  until certified,
#                           then the production host Channex issues with the
#                           production API key
#
# To confirm what a DEPLOYED app actually resolved, rather than what you meant
# to set: GET /api/debug/channex-probe and read `baseUrlInUse`. The variable
# can be set and still be wrong - a trailing slash, a typo, a deploy that has
# not picked it up.
CHANNEX_API_KEY=""
CHANNEX_BASE_URL="https://staging.channex.io/api/v1"
# Channex signs its webhooks with this. Distinct from WEBHOOK_SECRET below.
CHANNEX_WEBHOOK_SECRET=""
#
# ONE ENVIRONMENT AT A TIME may run the Channex crons against a given API key.
# GET /booking_revisions/feed is account-wide, not per-property, and
# acknowledging a revision removes it permanently. Two environments polling the
# same account means whichever runs first consumes the booking and the other
# never sees it - a confirmed guest whose stay silently does not exist.
# So: point the cron pinger at exactly one environment per Channex account.

# --- Cron and diagnostics -------------------------------------------------
#
# WEBHOOK_SECRET gates every /api/cron/* route, which is why those routes stay
# dormant in an environment nothing is pinging. An environment with no pinger
# runs no scheduled work regardless of what else is configured.
WEBHOOK_SECRET=""
# Which scheduled jobs THIS environment is actually pinged for, comma-separated.
# Unset means all of them.
#
# The watchdog alerts when a job it expects stops running. Once the Channex work
# moved to staging, production stopped being pinged for those jobs - correctly -
# and started reporting "drain-ari has stopped running" every twenty minutes,
# forever. An alert that always fires is how you learn to ignore alerts.
#
#   production  CRON_JOBS_EXPECTED=scheduled-messages,sync-messages,sync-reservations
#   staging     CRON_JOBS_EXPECTED=drain-ari,channex-messages,channex-revisions,channex-full-sync
CRON_JOBS_EXPECTED=""

# Gates /api/debug/*. Deliberately SEPARATE from WEBHOOK_SECRET: that one is
# handed to third parties (cron pingers, Channex webhook config) and lives in
# their dashboards, while these endpoints expose guest names, reservations and
# access-code state.
DEBUG_API_SECRET=""

# TTLock API
TTLOCK_CLIENT_ID="your-ttlock-client-id"
TTLOCK_CLIENT_SECRET="your-ttlock-client-secret"
TTLOCK_BASE_URL="https://euapi.ttlock.com"

# Email notifications (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your@email.com"

# Booking.com Connectivity API (requires partner approval)
BOOKING_API_KEY=""
BOOKING_HOTEL_ID=""

# Airbnb API (requires partner approval)
AIRBNB_CLIENT_ID=""
AIRBNB_CLIENT_SECRET=""
AIRBNB_ACCESS_TOKEN=""

# VRBO/Expedia API (requires partner approval)
VRBO_API_KEY=""
VRBO_ADVERTISER_ID=""
