generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("OWNER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  properties Property[]
  messages   Message[]  @relation("SentMessages")
  aiSettings AiSettings?
  aiHealth   AiHealth?
  ttlockAccount TTLockAccount?
  beds24Account Beds24Account?
  smoobuAccount SmoobuAccount?
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  messageTemplates   MessageTemplate[]
}

// A reusable guest-message template the host designs in StayHQ. Rendered with
// live reservation data (merge fields like [Full Name]) and sent automatically
// when its trigger fires (e.g. 2 days before check-in), or manually. This lets
// StayHQ own the whole messaging timeline instead of Smoobu's templates.
model MessageTemplate {
  id         String   @id @default(cuid())
  name       String
  // NEW_RESERVATION | BEFORE_CHECKIN | CHECKIN_DAY | DURING_STAY |
  // BEFORE_CHECKOUT | CHECKOUT_DAY | AFTER_CHECKOUT | MANUAL
  trigger    String
  offsetDays Int      @default(0) // days before/after the anchor for time-based triggers
  sendHour   Int      @default(10) // hour of day (0-23) to send scheduled messages
  subject    String   @default("Message from your host") // used when delivered by email
  body       String   // template text with [merge fields] and emojis
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // null = applies to all properties; otherwise scoped to one
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  sends MessageTemplateSend[]
  images TemplateImage[]

  @@index([userId])
}

// UNUSED — retained deliberately. Photo sending was dropped in favour of hosts
// pasting their own image links (e.g. a shared Google Drive folder) into the
// message body. The table still holds previously uploaded images, and
// `prisma db push` on boot would refuse to drop it without --accept-data-loss,
// crashing the start command. Remove it in a deliberate migration instead.
model TemplateImage {
  id        String   @id @default(cuid())
  url       String   // URL to the image (stored via Resend or file service)
  fileName  String   // original filename
  size      Int      // file size in bytes
  mimeType  String   @default("image/jpeg") // image/jpeg, image/png, etc.
  order     Int      @default(0) // display order
  createdAt DateTime @default(now())

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// One row per (template, reservation) actually sent — the dedupe ledger so a
// scheduled template fires at most once per booking.
model MessageTemplateSend {
  id            String   @id @default(cuid())
  reservationId String
  sentAt        DateTime @default(now())

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, reservationId])
  @@index([reservationId])
}

// An in-app notification shown in the bell menu. Created for events the host
// should notice — a guest needing a reply, the AI getting paused, a message
// that failed to reach the guest. Optionally also delivered as a web push.
model Notification {
  id        String   @id @default(cuid())
  type      String   // guest_reply | ai_paused | delivery_failed | checkout | info
  title     String
  body      String
  link      String? // in-app path to open when tapped, e.g. /messages?reservationId=...
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// A browser/PWA push subscription (one per installed device that opted in).
// Used to send Web Push notifications so alerts reach the phone even when the
// app is closed. Dead subscriptions are pruned when a push returns 404/410.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// LEGACY — Beds24 integration was removed in favor of Smoobu. The model is
// kept so the automatic schema sync never drops a table with data.
model Beds24Account {
  id           String   @id @default(cuid())
  refreshToken String
  token        String?
  expiresAt    DateTime?
  // When true, imported bookings generate PIN codes. Nothing is sent to the
  // guest on import — all guest messaging is driven from templates.
  automationEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Linked TTLock cloud account (stores OAuth tokens)
model TTLockAccount {
  id           String   @id @default(cuid())
  username     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  ttlockUid    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Core PMS models
model Property {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  country     String
  description String?
  bedrooms    Int      @default(1)
  bathrooms   Float    @default(1)
  maxGuests   Int      @default(2)
  basePrice   Float    @default(100)
  currency    String   @default("EUR")
  timezone    String   @default("UTC")
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  reservations  Reservation[]
  channels      ChannelConfig[]
  pricingRules  PricingRule[]
  calendarBlocks CalendarBlock[]
  locks         SmartLock[]
  cleaningTasks CleaningTask[]
  damageReports DamageReport[]
  checklistItems CleaningChecklistItem[]
  expenses      Expense[]
  recurringExpenses RecurringExpense[]
  perReservationCosts PerReservationCost[]
  knowledge     PropertyKnowledge[]
  messageTemplates MessageTemplate[]

  @@index([ownerId])
}

// Per-property knowledge base entries — the AI assistant answers guest
// questions from these facts.
model PropertyKnowledge {
  id        String   @id @default(cuid())
  category  String   // e.g. WiFi, Check-in & Check-out, Parking, House Rules...
  title     String   // short label, e.g. "WiFi password"
  content   String   // the actual knowledge, e.g. "Network: LoftNet, password: ..."
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

// Monthly fixed costs (electricity, internet, building maintenance...).
// Applied automatically to every month between startDate and endDate.
model RecurringExpense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  currency    String   @default("EUR")
  startDate   DateTime // first month it applies to
  endDate     DateTime? // null = still active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId])
}

// A cost incurred once per reservation (cleaning, laundry, welcome pack).
// Deliberately NOT stored as Expense rows: the month's total is amount x the
// number of reservations, recomputed on every report, so it tracks bookings
// added, moved or cancelled during the month without anyone editing a figure.
// Same approach as PlatformFeeSetting, which derives fees from revenue.
model PerReservationCost {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float    // cost for ONE reservation
  currency    String   @default("EUR")
  startDate   DateTime // first month it applies to
  endDate     DateTime? // null = still active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  propertyId String? // null = applies to every property
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId])
}

// Linked Smoobu account (channel manager bridge to Booking.com / Airbnb)
model SmoobuAccount {
  id     String @id @default(cuid())
  apiKey String
  // When true, imported bookings generate PIN codes. Nothing is sent to the
  // guest on import — all guest messaging is driven from templates.
  automationEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Commission percentage per booking channel (used to auto-compute platform fees)
model PlatformFeeSetting {
  id      String @id @default(cuid())
  ownerId String
  channel String // BOOKING, AIRBNB, VRBO, EXPEDIA
  percent Float

  @@unique([ownerId, channel])
}

// Finance module: cost tracking per property
model Expense {
  id          String   @id @default(cuid())
  category    String   // CLEANING, LAUNDRY, PLATFORM_FEES, ESSENTIALS, DAMAGES, INSURANCE, UTILITIES, MAINTENANCE, OTHER
  description String
  amount      Float
  currency    String   @default("EUR")
  date        DateTime
  invoiceImage String? // uploaded invoice photo (data URL)
  aiExtracted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional: null means a portfolio-wide cost (e.g. insurance for all)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  ownerId String

  @@index([propertyId])
  @@index([ownerId, date])
}

// Housekeeping / cleaning module
model CleaningTask {
  id            String   @id @default(cuid())
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  scheduledDate DateTime
  notes         String?
  // Cleaner arrival: timestamp + photos (JSON array of data URLs)
  checkInAt     DateTime?
  checkInPhotos String?
  // Cleaner done: timestamp + photos
  checkOutAt    DateTime?
  checkOutPhotos String?
  // Snapshot of the checklist: JSON [{ category, label, done }]
  checklist     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  damageReports DamageReport[]

  @@index([propertyId])
}

model DamageReport {
  id          String   @id @default(cuid())
  description String
  photos      String?  // JSON array of data URLs
  status      String   @default("OPEN") // OPEN, RESOLVED
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  cleaningTaskId String?
  cleaningTask   CleaningTask? @relation(fields: [cleaningTaskId], references: [id])

  @@index([propertyId])
}

// Custom per-property checklist items (falls back to a default template)
model CleaningChecklistItem {
  id       String  @id @default(cuid())
  category String
  label    String
  sortOrder Int    @default(0)
  active   Boolean @default(true)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Guest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  language  String   @default("en")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id              String   @id @default(cuid())
  confirmationCode String?
  status          String   @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  source          String   @default("DIRECT")    // BOOKING, AIRBNB, VRBO, EXPEDIA, DIRECT
  checkIn         DateTime
  checkOut        DateTime
  adults          Int      @default(1)
  children        Int      @default(0)
  totalAmount     Float?
  currency        String   @default("EUR")
  specialRequests String?
  internalNotes   String?
  externalId      String?  // ID from the OTA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Observability only - never read by /api/finance/report, which keeps
  // using PlatformFeeSetting's percent-of-revenue calculation regardless of
  // whether these are populated. Smoobu's own commission-included field is
  // only present on a fraction of live-synced reservations (confirmed: 6 of
  // 22 on a real account, correlated with the same bookings that also have
  // full guest contact details) - these exist to measure whether that gap
  // closes over time, not to be depended on for real numbers yet.
  platformCommission      Float?    // the actual amount Smoobu/Booking.com reports, when present
  platformCommissionSeenAt DateTime? // set once, the first time it went from null to populated

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id])

  messages     Message[]
  accessCodes  AccessCode[]
  cleaningTasks CleaningTask[]

  @@index([propertyId])
  @@index([guestId])
  @@index([checkIn, checkOut])
}

model Message {
  id        String   @id @default(cuid())
  body      String
  direction String   @default("INBOUND")  // INBOUND, OUTBOUND
  channel   String   @default("PLATFORM") // PLATFORM, EMAIL, SMS, INTERNAL
  source    String?  // booking, airbnb, vrbo, expedia, direct
  externalId String? // e.g. smoobu-msg-123 (dedupe for channel-synced messages)
  isAiGenerated Boolean @default(false)
  isDraft   Boolean  @default(false) // AI draft awaiting host approval — not sent
  isRead    Boolean  @default(false)
  // Inbound message the AI looked at but couldn't answer — host must reply
  needsHostReply Boolean @default(false)
  // For INTERNAL notes used as to-dos on the dashboard: flagged complete
  taskDone Boolean @default(false)
  // Outbound message whose relay to the booking channel (Booking.com/Airbnb via
  // Smoobu) failed — shown in the UI with a Retry action so it's never silent
  channelFailed Boolean @default(false)
  channelError  String? // the last relay error, surfaced in the UI for diagnosis
  // Detected once, lazily, when a thread is opened — null means "not checked
  // yet", never re-checked after that. "English" means the translate pill is
  // never shown for this message.
  detectedLanguage String?
  // Cached English translation, filled in the first time the host taps
  // Translate. Reusing it means opening the thread again never re-costs an
  // API call for a message already translated once.
  translatedBody   String?
  createdAt DateTime @default(now())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  senderId String?
  sender   User?   @relation("SentMessages", fields: [senderId], references: [id])

  @@index([reservationId])
}

model ChannelConfig {
  id         String  @id @default(cuid())
  channel    String  // BOOKING, AIRBNB, VRBO, EXPEDIA
  icalUrl    String? // iCal feed URL from the OTA
  apiKey     String?
  apiSecret  String?
  listingId  String? // OTA property/listing ID
  isActive   Boolean @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, channel])
}

model PricingRule {
  id         String   @id @default(cuid())
  name       String
  ruleType   String   @default("BASE")     // BASE, WEEKEND, SEASONAL, LAST_MINUTE, MINIMUM_STAY
  startDate  DateTime?
  endDate    DateTime?
  daysOfWeek String?  // JSON array: [0,1,2,3,4,5,6] (Sun=0)
  price      Float?
  adjustment Float?   // percentage or fixed amount
  adjType    String?  @default("PERCENT")  // PERCENT, FIXED
  minNights  Int?     @default(1)
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model CalendarBlock {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

// Smart Lock (TTLock)
model SmartLock {
  id         String  @id @default(cuid())
  ttlockId   String  @unique // TTLock device ID
  name       String
  batteryLevel Int?
  lockType   String  @default("PIN") // PIN, CARD, FINGERPRINT
  isActive   Boolean @default(true)
  checkInTime String @default("15:00") // time of day for check-in (HH:mm format)
  checkOutTime String @default("10:00") // time of day for check-out (HH:mm format)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  accessCodes AccessCode[]

  @@index([propertyId])
}

model AccessCode {
  id          String   @id @default(cuid())
  code        String
  codeType    String   @default("CUSTOM") // CUSTOM, PERIODIC
  ttlockKeyId String?  // ID returned by TTLock after creation
  validFrom   DateTime
  validTo     DateTime
  isActive    Boolean  @default(true)
  sentToGuest Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  lockId String
  lock   SmartLock @relation(fields: [lockId], references: [id])

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([lockId])
  @@index([reservationId])
}

// User-submitted improvement ideas (UX, navigation, features...)
model Feedback {
  id          String   @id @default(cuid())
  ownerId     String
  message     String
  screenshots String?  // JSON array of data URLs
  status      String   @default("NEW") // NEW, REVIEWED, DONE
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// AI configuration
model AiSettings {
  id                  String  @id @default(cuid())
  enabled             Boolean @default(true)
  autoReplyEnabled    Boolean @default(true)
  confidenceThreshold Float   @default(0.8)
  language            String  @default("en")
  customInstructions  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  templates AiTemplate[]
}

// Live health of the Anthropic API used by the AI assistant. One row per user,
// updated after every AI call. Lets the app show whether the assistant is
// working, when it last succeeded, and how much rate-limit headroom is left —
// and lets us email the owner the moment the API blocks a reply (rate limit
// hit, credits/spend cap exhausted, or a bad key). Note: Anthropic exposes
// rate-limit headroom on each response, but NOT a "remaining prepaid credit $"
// endpoint — so credit exhaustion is detected when it first bites, not before.
model AiHealth {
  id               String    @id @default(cuid())
  status           String    @default("unknown") // ok | error | unknown
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorType    String? // rate_limit | billing | auth | overloaded | other
  lastErrorMessage String?
  // Rate-limit headroom from the most recent response headers
  reqRemaining     Int?
  tokensRemaining  Int?
  tokensLimit      Int?
  resetAt          DateTime?
  // Debounces alert emails so one outage doesn't flood the inbox
  lastAlertAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiTemplate {
  id         String   @id @default(cuid())
  name       String
  trigger    String   // keywords or intent that triggers this template
  response   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  aiSettingsId String
  aiSettings   AiSettings @relation(fields: [aiSettingsId], references: [id])
}
