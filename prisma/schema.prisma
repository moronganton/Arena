generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("OWNER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  properties Property[]
  messages   Message[]  @relation("SentMessages")
  aiSettings AiSettings?
  aiHealth   AiHealth?
  ttlockAccount TTLockAccount?
  beds24Account Beds24Account?
  smoobuAccount SmoobuAccount?
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  messageTemplates   MessageTemplate[]
}

// A reusable guest-message template the host designs in StayHQ. Rendered with
// live reservation data (merge fields like [Full Name]) and sent automatically
// when its trigger fires (e.g. 2 days before check-in), or manually. This lets
// StayHQ own the whole messaging timeline instead of Smoobu's templates.
model MessageTemplate {
  id         String   @id @default(cuid())
  name       String
  // NEW_RESERVATION | BEFORE_CHECKIN | CHECKIN_DAY | DURING_STAY |
  // BEFORE_CHECKOUT | CHECKOUT_DAY | AFTER_CHECKOUT | MANUAL
  trigger    String
  offsetDays Int      @default(0) // days before/after the anchor for time-based triggers
  sendHour   Int      @default(10) // hour of day (0-23) to send scheduled messages
  subject    String   @default("Message from your host") // used when delivered by email
  body       String   // template text with [merge fields] and emojis
  // JSON array of data URLs (data:<mime>;base64,...) - same convention as
  // Message.attachments. Not the old TemplateImage table below (URL-based,
  // deliberately unused) - this reuses the storage approach already proven
  // live through Channex's Messages API.
  attachments String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // null = applies to all properties; otherwise scoped to one
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  sends MessageTemplateSend[]
  images TemplateImage[]

  @@index([userId])
}

// UNUSED — retained deliberately. Photo sending was dropped in favour of hosts
// pasting their own image links (e.g. a shared Google Drive folder) into the
// message body. The table still holds previously uploaded images, and
// `prisma db push` on boot would refuse to drop it without --accept-data-loss,
// crashing the start command. Remove it in a deliberate migration instead.
model TemplateImage {
  id        String   @id @default(cuid())
  url       String   // URL to the image (stored via Resend or file service)
  fileName  String   // original filename
  size      Int      // file size in bytes
  mimeType  String   @default("image/jpeg") // image/jpeg, image/png, etc.
  order     Int      @default(0) // display order
  createdAt DateTime @default(now())

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// One row per (template, reservation) actually sent — the dedupe ledger so a
// scheduled template fires at most once per booking.
model MessageTemplateSend {
  id            String   @id @default(cuid())
  reservationId String
  sentAt        DateTime @default(now())

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, reservationId])
  @@index([reservationId])
}

// An in-app notification shown in the bell menu. Created for events the host
// should notice — a guest needing a reply, the AI getting paused, a message
// that failed to reach the guest. Optionally also delivered as a web push.
model Notification {
  id        String   @id @default(cuid())
  type      String   // guest_reply | ai_paused | delivery_failed | checkout | mapping_issue | ari_failed | cron_stale | app_error | info
  title     String
  body      String
  link      String? // in-app path to open when tapped, e.g. /messages?reservationId=...
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// A browser/PWA push subscription (one per installed device that opted in).
// Used to send Web Push notifications so alerts reach the phone even when the
// app is closed. Dead subscriptions are pruned when a push returns 404/410.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// LEGACY — Beds24 integration was removed in favor of Smoobu. The model is
// kept so the automatic schema sync never drops a table with data.
model Beds24Account {
  id           String   @id @default(cuid())
  refreshToken String
  token        String?
  expiresAt    DateTime?
  // When true, imported bookings generate PIN codes. Nothing is sent to the
  // guest on import — all guest messaging is driven from templates.
  automationEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Linked TTLock cloud account (stores OAuth tokens)
model TTLockAccount {
  id           String   @id @default(cuid())
  username     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  ttlockUid    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Core PMS models
model Property {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  country     String
  description String?
  bedrooms    Int      @default(1)
  bathrooms   Float    @default(1)
  maxGuests   Int      @default(2)
  basePrice   Float    @default(100)
  currency    String   @default("EUR")
  timezone    String   @default("UTC")
  imageUrl    String?
  active      Boolean  @default(true)
  // Per-property override of the account-wide AI Assistant switch - lets a
  // host run the assistant for some properties and handle others by hand,
  // without turning it off account-wide.
  aiEnabled   Boolean  @default(true)
  // Which channel manager owns this property's OTA connectivity. Two
  // managers must never own the same listing at once - Smoobu and Channex
  // would fight over availability and could cause an overbooking - so this
  // is exclusive. It's what lets properties migrate to Channex one at a
  // time instead of all at once. Every existing property defaults to
  // SMOOBU, matching how they're actually connected today.
  channelProvider String @default("SMOOBU") // SMOOBU | CHANNEX | NONE
  // Local guest city tax, e.g. Bratislava's 3.5 EUR/guest/night. Null means
  // not applicable - most properties have no such tax. Deliberately NOT a
  // Channex concept: the Channex Payment API only charges against a Channex
  // booking_id, which Smoobu-sourced reservations never have (see
  // lib/city-tax.ts), so this is a plain Stripe flow that works for any
  // property regardless of which channel manager owns it.
  cityTaxPerNight Float?
  // The rest of this block mirrors Channex's real Tax object field for
  // field (confirmed live, including the two least-obvious enum values -
  // type "fee" and logic "per_booking" - via a real create/read-back/delete
  // round trip, not guessed from the UI labels alone) - so StayHQ is the
  // one place to configure this, pushed to Channex from here rather than
  // edited separately in both places. See lib/channels/channex-taxes.ts.
  cityTaxTitle       String  @default("City tax")
  cityTaxIsInclusive Boolean @default(false)
  // percent | per_booking | per_room | per_night | per_person |
  // per_room_per_night | per_person_per_night
  cityTaxLogic       String  @default("per_person_per_night")
  // tax | city_tax | fee
  cityTaxType        String  @default("city_tax")
  cityTaxMaxNights   Int?
  cityTaxSkipNights  Int?
  // The Channex tax's own id, once synced - looked up by id from here on,
  // not by (property_id, type), since type is now something a host can
  // change on either side. Null until the first successful sync; for a
  // property where a tax already existed in Channex before this sync did
  // (Sinteu's real one), the first sync finds and adopts it by matching
  // property_id + type once, then remembers its id from then on.
  cityTaxChannexId  String?
  // Off by default, deliberately - a host turns this on only once they trust
  // the flow: with it on, a template containing [City Tax Card Link] sends a
  // real save-card link, and any reservation with a saved card and no paid
  // charge yet gets auto-charged the quoted amount on the next cron cycle.
  // With it off, the merge field resolves to nothing and no auto-charge ever
  // runs - every existing manual "Send card link" / "Charge" button keeps
  // working exactly as before regardless of this flag.
  cityTaxAutoChargeEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  reservations  Reservation[]
  channels      ChannelConfig[]
  pricingRules  PricingRule[]
  calendarBlocks CalendarBlock[]
  locks         SmartLock[]
  cleaningTasks CleaningTask[]
  damageReports DamageReport[]
  checklistItems CleaningChecklistItem[]
  expenses      Expense[]
  recurringExpenses RecurringExpense[]
  perReservationCosts PerReservationCost[]
  knowledge     PropertyKnowledge[]
  messageTemplates MessageTemplate[]
  channexListing ChannexListing?
  ariOutbox      AriOutbox[]

  @@index([ownerId])
}

// Channex models a property as three nested objects (property -> room type
// -> rate plan). Stored per StayHQ property so ARI pushes and the messaging
// integration know what to address on Channex's side.
model ChannexListing {
  id                String   @id @default(cuid())
  channexPropertyId String
  channexRoomTypeId String
  channexRatePlanId String
  createdAt         DateTime @default(now())
  // Set once, the first time the Channex Payment App is installed and its
  // Stripe OAuth connection completes for this property (see
  // lib/channels/channex-payments.ts). Null means the app isn't set up yet -
  // every payment call needs both.
  paymentInstallationId String?
  paymentProviderId     String?

  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id])

  ratePlans RatePlan[]
}

// The rate plans a listing sells, which is what lifts the old one-plan-per-
// property limit.
//
// StayHQ still resolves exactly ONE price per date - see rate-materializer.ts -
// and still pushes that single stream into one plan. What changes is that the
// plan it pushes into can now be the PARENT of a family, with the rest DERIVED
// from it by a percentage that Channex applies itself. That is how a property
// sells six products off one price: Standard, a non-refundable at -5%, a weekly
// rate at -15%, a monthly at -25%, and short-stay plans at a premium.
//
// Why derived rather than independent: a derived child needs no second price
// stream, so nothing here has to know how many nights a guest is booking. That
// question is only answerable at search time, by the OTA, which is exactly why
// length-of-stay pricing lives in plan structure and not in PricingRule.
model RatePlan {
  id String @id @default(cuid())

  // Channex's own id. Null until this plan has been provisioned there.
  channexRatePlanId String?

  title String

  // PARENT is the plan ARI is pushed into - exactly one per listing, and the
  // one ChannexListing.channexRatePlanId points at. DERIVED plans are never
  // pushed to; Channex recomputes them whenever the parent moves.
  kind String @default("DERIVED") // PARENT | DERIVED

  // How this plan's price follows the parent's. Exactly one of these is set on
  // a derived plan; both are null on the parent, which has nothing to derive
  // from.
  //
  // Percent applied to the parent's rate: positive is a surcharge (a one-night
  // stay at +60%), negative a discount (a weekly rate at -15%).
  derivedPercent Float?

  // A flat amount in the property's currency, added or subtracted. Breakfast
  // is the case that needs this: it costs EUR 12 a night, not 10%, and
  // encoding a fixed cost as a proportional one is right at EUR 120 and wrong
  // at EUR 200 the moment a season rule moves the base. Booking.com's own
  // "Price difference" control offers a currency and a percent side by side,
  // so a plan mirrored from there can need either.
  derivedAmount Float?

  // What Channex calls meal_type. Booking.com carries the same thing as
  // "Meals" on the rate plan - a breakfast plan whose meal type says none
  // would advertise wrong on a channel that reads it from Channex.
  mealType String?

  // This plan's own minimum stay on arrival, and the entire reason it exists as
  // a separate product. Provisioned with inherit_min_stay_arrival = false so the
  // parent's per-date min-stay pushes cannot overwrite it.
  minStayArrival Int @default(1)

  // Order shown to the operator; also the order they are created in, so a
  // parent is always provisioned before anything deriving from it.
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channexListingId String
  channexListing   ChannexListing @relation(fields: [channexListingId], references: [id], onDelete: Cascade)

  @@index([channexListingId])
}

// One row queued per date range that needs pushing to Channex. Never call
// Channex inline on save - reservation changes, CalendarBlock edits, and
// PricingRule/basePrice edits all enqueue here instead, and a worker drains
// the queue in batches. This is what lets a burst of edits coalesce into a
// handful of calls instead of one per change, and what keeps a slow or
// failing Channex call from blocking the request that triggered it.
//
// Only ever written for properties with channelProvider = CHANNEX - with
// Smoobu, availability/prices flow in, not out, so this table stays empty
// for every property until one actually migrates.
model AriOutbox {
  id        String   @id @default(cuid())
  dateFrom  DateTime
  dateTo    DateTime
  kind      String   // AVAILABILITY | RATE | RESTRICTION
  status    String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts  Int      @default(0)
  lastError String?

  // The Channex task ids returned by the call that settled this row, as a
  // JSON array. Kept because a task id is the only handle on what Channex
  // actually received: it is what certification is graded on, and what
  // answers "did this price really reach the channel" after the fact. The
  // drain used to return them to its caller and drop them on the floor.
  taskIds   String?
  // A failed row is not retried before this - exponential backoff needs
  // somewhere to record "when", not just "how many times". Null means
  // eligible immediately (a fresh PENDING row, or a row that has never
  // failed).
  nextAttemptAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, status])
  @@index([status, createdAt])
}

// Every Channex webhook delivery, stored before any processing is attempted.
//
// Channex certification requires the receiver to return 200 even when our own
// processing fails - returning 500 makes Channex retry and eventually
// disable the webhook. That means a failure has to be recorded somewhere
// rather than surfaced in the HTTP response, which is what this table is
// for: "log and flag internally instead of returning 500".
//
// It doubles as the payload-discovery mechanism. The API refuses to create
// bookings directly (403), so the real booking shape can only be learned
// from an actual delivery - either the dashboard's "Send test message" or a
// genuine OTA booking.
model ChannexWebhookLog {
  id            String   @id @default(cuid())
  event         String?  // event_mask value, e.g. "booking"
  payload       String   // raw request body, exactly as received
  headers       String?  // raw headers, for diagnosing auth/signature problems
  processedOk   Boolean  @default(false)
  error         String?
  reservationId String?  // set when a delivery resulted in a reservation
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([processedOk])
}

// Per-property knowledge base entries — the AI assistant answers guest
// questions from these facts.
model PropertyKnowledge {
  id        String   @id @default(cuid())
  category  String   // e.g. WiFi, Check-in & Check-out, Parking, House Rules...
  title     String   // short label, e.g. "WiFi password"
  content   String   // the actual knowledge, e.g. "Network: LoftNet, password: ..."
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

// Monthly fixed costs (electricity, internet, building maintenance...).
// Applied automatically to every month between startDate and endDate.
model RecurringExpense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  currency    String   @default("EUR")
  startDate   DateTime // first month it applies to
  endDate     DateTime? // null = still active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId])
}

// A cost incurred once per reservation (cleaning, laundry, welcome pack).
// Deliberately NOT stored as Expense rows: the month's total is amount x the
// number of reservations, recomputed on every report, so it tracks bookings
// added, moved or cancelled during the month without anyone editing a figure.
// Same approach as PlatformFeeSetting, which derives fees from revenue.
model PerReservationCost {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float    // cost for ONE reservation
  currency    String   @default("EUR")
  startDate   DateTime // first month it applies to
  endDate     DateTime? // null = still active
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  propertyId String? // null = applies to every property
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([ownerId])
}

// Linked Smoobu account (channel manager bridge to Booking.com / Airbnb)
model SmoobuAccount {
  id     String @id @default(cuid())
  apiKey String
  // When true, imported bookings generate PIN codes. Nothing is sent to the
  // guest on import — all guest messaging is driven from templates.
  automationEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Commission percentage per booking channel (used to auto-compute platform fees)
model PlatformFeeSetting {
  id      String @id @default(cuid())
  ownerId String
  channel String // BOOKING, AIRBNB, VRBO, EXPEDIA
  percent Float

  @@unique([ownerId, channel])
}

// Finance module: cost tracking per property
model Expense {
  id          String   @id @default(cuid())
  category    String   // CLEANING, LAUNDRY, PLATFORM_FEES, ESSENTIALS, DAMAGES, INSURANCE, UTILITIES, MAINTENANCE, OTHER
  description String
  amount      Float
  currency    String   @default("EUR")
  date        DateTime
  invoiceImage String? // uploaded invoice photo (data URL)
  aiExtracted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional: null means a portfolio-wide cost (e.g. insurance for all)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  ownerId String

  @@index([propertyId])
  @@index([ownerId, date])
}

// Housekeeping / cleaning module
model CleaningTask {
  id            String   @id @default(cuid())
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  scheduledDate DateTime
  notes         String?
  // Cleaner arrival: timestamp + photos (JSON array of data URLs)
  checkInAt     DateTime?
  checkInPhotos String?
  // Cleaner done: timestamp + photos
  checkOutAt    DateTime?
  checkOutPhotos String?
  // Snapshot of the checklist: JSON [{ category, label, done }]
  checklist     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  damageReports DamageReport[]

  @@index([propertyId])
}

model DamageReport {
  id          String   @id @default(cuid())
  description String
  photos      String?  // JSON array of data URLs
  status      String   @default("OPEN") // OPEN, RESOLVED
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  cleaningTaskId String?
  cleaningTask   CleaningTask? @relation(fields: [cleaningTaskId], references: [id])

  @@index([propertyId])
}

// Custom per-property checklist items (falls back to a default template)
model CleaningChecklistItem {
  id       String  @id @default(cuid())
  category String
  label    String
  sortOrder Int    @default(0)
  active   Boolean @default(true)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Guest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  language  String   @default("en")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id              String   @id @default(cuid())
  confirmationCode String?
  status          String   @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  source          String   @default("DIRECT")    // BOOKING, AIRBNB, VRBO, EXPEDIA, DIRECT
  checkIn         DateTime
  checkOut        DateTime
  adults          Int      @default(1)
  children        Int      @default(0)
  totalAmount     Float?
  currency        String   @default("EUR")
  specialRequests String?
  internalNotes   String?
  // Unique so a re-import can never quietly create a second reservation for
  // a stay that already exists. That is not hypothetical: a change to how
  // this id was built left older rows unrecognisable, the poller treated
  // those bookings as new, and each duplicate generated its own PIN on a real
  // door lock. A constraint turns that into a failed insert instead of a
  // second key. Postgres allows any number of NULLs, so direct bookings with
  // no OTA reference are unaffected.
  externalId      String?  @unique // ID from the OTA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Observability only - never read by /api/finance/report, which keeps
  // using PlatformFeeSetting's percent-of-revenue calculation regardless of
  // whether these are populated. Smoobu's own commission-included field is
  // only present on a fraction of live-synced reservations (confirmed: 6 of
  // 22 on a real account, correlated with the same bookings that also have
  // full guest contact details) - these exist to measure whether that gap
  // closes over time, not to be depended on for real numbers yet.
  platformCommission      Float?    // the actual amount Smoobu/Booking.com reports, when present
  platformCommissionSeenAt DateTime? // set once, the first time it went from null to populated

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id])

  messages     Message[]
  accessCodes  AccessCode[]
  cleaningTasks CleaningTask[]
  cityTaxCharges CityTaxCharge[]
  guestCardOnFile GuestCardOnFile?

  @@index([propertyId])
  @@index([guestId])
  @@index([checkIn, checkOut])
}

// A card saved via Stripe (SetupIntent, through a Checkout Session in
// "setup" mode) without charging it - the "eventual future charge" pattern:
// send this link at booking time, then charge the exact city tax amount
// later from chargeSavedCard() once nights/guests are final, with no second
// trip back to the guest. One per reservation - a new link simply updates
// this same row, matching how the guest only ever has one card on file at a
// time for a given stay.
model GuestCardOnFile {
  id                    String   @id @default(cuid())
  status                String   @default("PENDING") // PENDING (link sent, not completed), SAVED, FAILED
  stripeCustomerId      String?
  stripePaymentMethodId String?
  stripeSessionId       String?  @unique // the setup-mode Checkout Session - null once superseded by a resend
  cardBrand             String?
  cardLast4             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

// A guest-facing city tax charge (e.g. Bratislava's 3.5 EUR/guest/night),
// collected by card via a Stripe Checkout link instead of the current manual
// bank transfer nobody can verify without asking the guest. See
// lib/city-tax.ts for why this is plain Stripe rather than routed through
// Channex's Payment API - that API only charges against a Channex booking_id,
// which a Smoobu-sourced reservation never has.
model CityTaxCharge {
  id            String   @id @default(cuid())
  amountCents   Int      // total due, minor currency units
  currency      String
  guests        Int      // occupancy the amount was computed from, for the record
  nights        Int
  perNightCents Int
  status        String   @default("PENDING") // PENDING, PAID, CANCELED
  stripeSessionId        String?  @unique
  stripePaymentIntentId  String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  body      String
  direction String   @default("INBOUND")  // INBOUND, OUTBOUND
  channel   String   @default("PLATFORM") // PLATFORM, EMAIL, SMS, INTERNAL
  source    String?  // booking, airbnb, vrbo, expedia, direct
  externalId String? // e.g. smoobu-msg-123 (dedupe for channel-synced messages)
  // JSON array of data URLs (data:<mime>;base64,...) - guest- or host-sent
  // files. Same convention as CleaningTask.photos: stored directly rather
  // than in a separate file-storage service, since volume is low.
  attachments String?
  isAiGenerated Boolean @default(false)
  isDraft   Boolean  @default(false) // AI draft awaiting host approval — not sent
  isRead    Boolean  @default(false)
  // Inbound message the AI looked at but couldn't answer — host must reply
  needsHostReply Boolean @default(false)
  // For INTERNAL notes used as to-dos on the dashboard: flagged complete
  taskDone Boolean @default(false)
  // Outbound message whose relay to the booking channel (Booking.com/Airbnb via
  // Smoobu) failed — shown in the UI with a Retry action so it's never silent
  channelFailed Boolean @default(false)
  channelError  String? // the last relay error, surfaced in the UI for diagnosis
  // Detected once, lazily, when a thread is opened — null means "not checked
  // yet", never re-checked after that. "English" means the translate pill is
  // never shown for this message.
  detectedLanguage String?
  // Cached English translation, filled in the first time the host taps
  // Translate. Reusing it means opening the thread again never re-costs an
  // API call for a message already translated once.
  translatedBody   String?
  createdAt DateTime @default(now())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  senderId String?
  sender   User?   @relation("SentMessages", fields: [senderId], references: [id])

  @@index([reservationId])
}

model ChannelConfig {
  id         String  @id @default(cuid())
  channel    String  // BOOKING, AIRBNB, VRBO, EXPEDIA
  icalUrl    String? // iCal feed URL from the OTA
  apiKey     String?
  apiSecret  String?
  listingId  String? // OTA property/listing ID
  isActive   Boolean @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, channel])
}

model PricingRule {
  id         String   @id @default(cuid())
  name       String
  ruleType   String   @default("BASE")     // BASE, WEEKEND, SEASONAL, LAST_MINUTE, MINIMUM_STAY
  startDate  DateTime?
  endDate    DateTime?
  daysOfWeek String?  // JSON array: [0,1,2,3,4,5,6] (Sun=0)
  price      Float?
  adjustment Float?   // percentage or fixed amount
  adjType    String?  @default("PERCENT")  // PERCENT, FIXED
  minNights  Int?     @default(1)
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model CalendarBlock {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

// Smart Lock (TTLock)
model SmartLock {
  id         String  @id @default(cuid())
  ttlockId   String  @unique // TTLock device ID
  name       String
  batteryLevel Int?
  lockType   String  @default("PIN") // PIN, CARD, FINGERPRINT
  isActive   Boolean @default(true)
  checkInTime String @default("15:00") // time of day for check-in (HH:mm format)
  checkOutTime String @default("10:00") // time of day for check-out (HH:mm format)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  accessCodes AccessCode[]

  @@index([propertyId])
}

model AccessCode {
  id          String   @id @default(cuid())
  code        String
  codeType    String   @default("CUSTOM") // CUSTOM, PERIODIC
  ttlockKeyId String?  // ID returned by TTLock after creation
  validFrom   DateTime
  validTo     DateTime
  isActive    Boolean  @default(true)
  sentToGuest Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  lockId String
  lock   SmartLock @relation(fields: [lockId], references: [id])

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([lockId])
  @@index([reservationId])
}

// User-submitted improvement ideas (UX, navigation, features...)
model Feedback {
  id          String   @id @default(cuid())
  ownerId     String
  message     String
  screenshots String?  // JSON array of data URLs
  status      String   @default("NEW") // NEW, REVIEWED, DONE
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// AI configuration
model AiSettings {
  id                  String  @id @default(cuid())
  enabled             Boolean @default(true)
  autoReplyEnabled    Boolean @default(true)
  confidenceThreshold Float   @default(0.8)
  language            String  @default("en")
  customInstructions  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  templates AiTemplate[]
}

// Live health of the Anthropic API used by the AI assistant. One row per user,
// updated after every AI call. Lets the app show whether the assistant is
// working, when it last succeeded, and how much rate-limit headroom is left —
// and lets us email the owner the moment the API blocks a reply (rate limit
// hit, credits/spend cap exhausted, or a bad key). Note: Anthropic exposes
// rate-limit headroom on each response, but NOT a "remaining prepaid credit $"
// endpoint — so credit exhaustion is detected when it first bites, not before.
model AiHealth {
  id               String    @id @default(cuid())
  status           String    @default("unknown") // ok | error | unknown
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorType    String? // rate_limit | billing | auth | overloaded | other
  lastErrorMessage String?
  // Rate-limit headroom from the most recent response headers
  reqRemaining     Int?
  tokensRemaining  Int?
  tokensLimit      Int?
  resetAt          DateTime?
  // Debounces alert emails so one outage doesn't flood the inbox
  lastAlertAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiTemplate {
  id         String   @id @default(cuid())
  name       String
  trigger    String   // keywords or intent that triggers this template
  response   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  aiSettingsId String
  aiSettings   AiSettings @relation(fields: [aiSettingsId], references: [id])
}

// One row per scheduled-job run, so a job that starts failing is visible
// somewhere other than the server logs.
//
// The cron routes here fire their work in the background and return
// immediately, because free cron pingers cap the request timeout well below
// how long a full run takes. That has a cost: the HTTP 200 the pinger sees
// says only "the request arrived", never "the work succeeded", so a job can
// fail every quarter of an hour indefinitely while the pinger reports it
// healthy. For guest-message collection that means guests going unanswered
// with nothing raising a hand.
//
// A run cannot report on itself under that pattern, but it can report on the
// one before it: the route reads the previous run's outcome and answers
// non-2xx if it failed, which turns the pinger's own failure alerting back
// into a working signal, one cycle late.
model CronRun {
  id         String    @id @default(cuid())
  job        String    // channex-messages | channex-revisions | drain-ari | sync-reservations
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?  // null while still running
  summary    String?   // JSON counts from the run, for a quick read of what it did
  error      String?

  @@index([job, startedAt])
}
